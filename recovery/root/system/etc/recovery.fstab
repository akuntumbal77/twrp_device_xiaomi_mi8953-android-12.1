# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#
# NOTE: this is the static base. /data, /metadata and the system/vendor group
# (static "cust" layout OR logical/dynamic layout) are appended at boot time
# by system/bin/merge-fstab.sh, which detects at runtime whether the flashed
# firmware uses the mi8953_dynpart retrofit-dynamic super partition or the
# legacy static "cust" partition.

#<src>                                      <mnt_point>     <type>      <mnt_flags and options>                             <fs_mgr_flags>
/dev/block/bootdevice/by-name/boot          /boot           emmc        defaults                                             defaults
/dev/block/bootdevice/by-name/recovery      /recovery       emmc        defaults                                             defaults
/dev/block/bootdevice/by-name/misc          /misc           emmc        defaults                                             defaults
/dev/block/bootdevice/by-name/cache         /cache          ext4        nosuid,nodev,noatime                                wait,formattable,check
